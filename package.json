{
  "name": "crypto-lab-world-ciphers",
  "version": "1.0.0",
  "description": "Interactive browser demo of seven national block ciphers (Camellia, ARIA, SM4, Kuznyechik, Kalyna, BelT, SEED), verified against official test vectors.",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run test:publish-request && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:a11y": "playwright test",
    "deploy": "gh workflow run deploy-pages.yml --repo systemslibrarian/crypto-lab-world-ciphers --ref main",
    "test:publish-request": "node --test tests/publish-request.node.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemslibrarian/crypto-lab-world-ciphers.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/systemslibrarian/crypto-lab-world-ciphers/issues"
  },
  "homepage": "https://github.com/systemslibrarian/crypto-lab-world-ciphers#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@li0ard/belt": "^0.1.5",
    "@li0ard/kalyna": "^0.1.6",
    "@li0ard/kuznyechik": "^0.1.5",
    "@noble/ciphers": "^2.4.0",
    "gm-crypto": "^0.1.12",
    "kisa-seed": "^1.1.0"
  }
}
